<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InsightFlow.Desktop</RootNamespace>
    <AssemblyName>InsightFlow.Desktop</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\insightflow.ico</ApplicationIcon>
    <!-- A versão também nomeia o instalador (installer/build.ps1). -->
    <Version>1.0.0</Version>
    <Product>InsightFlow</Product>
    <AssemblyTitle>InsightFlow</AssemblyTitle>
    <Company>InsightF-AI</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fica ao lado do executável mesmo na publicação em arquivo único, para a URL da API poder ser editada. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="Assets\insightflow.ico" LogicalName="InsightFlow.Desktop.insightflow.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InsightFlow.Desktop.Tests" />
  </ItemGroup>
</Project>
